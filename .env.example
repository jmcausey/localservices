# Flask session signing key. Generate a long random value for production.
FLASK_SECRET_KEY=replace-with-a-random-secret

# Google OAuth 2.0 / OpenID Connect web application credentials.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Register this exact callback URL in Google Cloud:
# https://your-host.example.com/auth/callback
